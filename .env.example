# 開発用の設定。`cp .env.example .env` してから docker compose up する。
# docker compose はこのファイルを「${...} の変数展開」と「env_file（コンテナの環境変数）」の両方に使う。

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_DB=pyslack
POSTGRES_USER=pyslack
POSTGRES_PASSWORD=pyslack-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis（channel layer とプレゼンスで共用。キーのプレフィックスで区別する）---
REDIS_URL=redis://redis:6379/0

# --- S3 / MinIO ---
AWS_ACCESS_KEY_ID=pyslack-minio
AWS_SECRET_ACCESS_KEY=pyslack-minio-dev-password
AWS_STORAGE_BUCKET_NAME=pyslack
AWS_S3_REGION_NAME=us-east-1
# backend コンテナから MinIO への接続先（HEAD / DELETE など、サーバー自身が呼ぶ操作用）
AWS_S3_ENDPOINT_URL=http://minio:9000
# ブラウザに渡す署名付き URL のホスト（ブラウザからは minio:9000 が名前解決できないため）
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
